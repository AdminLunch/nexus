{
  "name": "nexus",
  "private": true,
  "type": "module",
  "description": "NEXUS — persoonlijk dashboard (statische PWA). Alleen nodig om de tests te draaien.",
  "scripts": {
    "test": "node tests/unit.mjs && node --test tests/kompas/*.test.mjs",
    "test:unit": "node tests/unit.mjs",
    "test:kompas": "node --test tests/kompas/*.test.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "test:artifact": "node tools/build-artifact.mjs && node tests/artifact.smoke.mjs http://localhost:8080/dist/artifact/",
    "test:upgrade": "node tests/upgrade-from-artifact.mjs",
    "build:artifact": "node tools/build-artifact.mjs"
  },
  "devDependencies": {
    "playwright": "1.48.2"
  }
}
